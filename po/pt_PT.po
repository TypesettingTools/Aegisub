#: ../src/dialog_video_properties.cpp:464
#, c-format
msgid ""
"The resolution of the loaded video and the layout resolution specified for the subtitles don't match.\n"
"\n"
"Video resolution:    %d × %d\n"
"Subtitle layout resolution:    %d × %d\n"
"\n"
