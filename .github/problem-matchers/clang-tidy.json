{
  "problemMatcher": [
    {
      "owner": "clang-tidy",
      "pattern": [
        {
          "regexp": "^(.+?):([0-9]+):([0-9]+): (warning|error): (.+?) \\[([^]]+)\\](?:,.*)?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      ]
    }
  ]
}
